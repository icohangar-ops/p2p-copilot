# P2P Copilot Configuration
# Copy to .env and fill in your values

# UiPath Automation Cloud
P2P_UIPATH__CLOUD_URL=https://cloud.uipath.com
P2P_UIPATH__ORG_NAME=your-org-name
P2P_UIPATH__TENANT_NAME=your-tenant
P2P_UIPATH__CLIENT_ID=your-client-id
P2P_UIPATH__CLIENT_SECRET=your-client-secret
P2P_UIPATH__ORCHESTRATOR_FOLDER=P2P-Copilot

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-your-key-here
P2P_CLAUDE__MODEL=claude-sonnet-4-20250514
P2P_CLAUDE__MAX_TOKENS=4096
P2P_CLAUDE__TEMPERATURE=0.1

# Application
P2P_DEBUG=false
P2P_LOG_LEVEL=INFO
