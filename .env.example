# P2P Copilot Configuration
# Copy to .env and fill in your values

# UiPath Automation Cloud
P2P_UIPATH__CLOUD_URL=https://cloud.uipath.com
P2P_UIPATH__ORG_NAME=your-org-name
P2P_UIPATH__TENANT_NAME=your-tenant
P2P_UIPATH__CLIENT_ID=your-client-id
P2P_UIPATH__CLIENT_SECRET=your-client-secret
P2P_UIPATH__ORCHESTRATOR_FOLDER=P2P-Copilot

# LLM API (OpenAI-compatible — works with Z.ai, OpenAI, etc.)
P2P_LLM__PROVIDER=z.ai
P2P_LLM__BASE_URL=https://api.z.ai/api/paas/v4/
P2P_LLM__API_KEY=your-zai-api-key-here
P2P_LLM__MODEL=glm-5
P2P_LLM__MAX_TOKENS=4096
P2P_LLM__TEMPERATURE=0.1

# Application
P2P_DEBUG=false
P2P_LOG_LEVEL=INFO
